rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function isChatParticipant(chatId) {
      return request.auth != null &&
        request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.participants;
    }

    function canSeeEvent(eventId) {
      let creatorId = get(/databases/$(database)/documents/events/$(eventId)).data.creatorId;
      return isSignedIn() && (
        creatorId == request.auth.uid ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(creatorId))
      );
    }

    match /admin/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /notes/{userId} {
      allow read: if isSignedIn();

      allow create, update: if isOwner(userId) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() >= 1 &&
        request.resource.data.content.size() <= 50 &&
        (request.resource.data.createdAt == null ||
         request.resource.data.createdAt is timestamp);

      allow delete: if isOwner(userId);
    }

    match /events/{eventId} {

      allow read: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(resource.data.creatorId))
      );

      allow create: if isSignedIn() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'createAt', 'creatorId', 'eventBanner', 'eventDate',
          'eventDescription', 'eventLocation', 'eventTitle'
        ]) &&
        request.resource.data.createAt == request.time &&
        request.resource.data.eventDate is timestamp &&
        request.resource.data.eventDate > request.time &&
        request.resource.data.eventTitle is string &&
        request.resource.data.eventTitle.size() > 0 &&
        request.resource.data.eventTitle.size() <= 50 &&
        request.resource.data.eventDescription is string &&
        request.resource.data.eventDescription.size() <= 500 &&
        request.resource.data.eventLocation is string &&
        request.resource.data.eventLocation.size() > 0 &&
        request.resource.data.eventLocation.size() <= 80 &&
        request.resource.data.eventBanner is string;

      allow update: if isSignedIn() &&
        resource.data.creatorId == request.auth.uid &&
        request.resource.data.creatorId == resource.data.creatorId &&
        request.resource.data.createAt == resource.data.createAt &&
        request.resource.data.keys().hasOnly([
          'createAt', 'creatorId', 'eventBanner', 'eventDate',
          'eventDescription', 'eventLocation', 'eventTitle'
        ]) &&
        request.resource.data.eventDate is timestamp &&
        (request.resource.data.eventDate == resource.data.eventDate ||
         request.resource.data.eventDate > request.time) &&
        request.resource.data.eventTitle is string &&
        request.resource.data.eventTitle.size() > 0 &&
        request.resource.data.eventTitle.size() <= 50 &&
        request.resource.data.eventDescription is string &&
        request.resource.data.eventDescription.size() <= 500 &&
        request.resource.data.eventLocation is string &&
        request.resource.data.eventLocation.size() > 0 &&
        request.resource.data.eventLocation.size() <= 80 &&
        request.resource.data.eventBanner is string;

      allow delete: if isSignedIn() &&
        resource.data.creatorId == request.auth.uid;

      match /{status}/{uid} {
        allow read: if status in ['going', 'maybe'] &&
          canSeeEvent(eventId);

        allow create, update: if status in ['going', 'maybe'] &&
          isOwner(uid) &&
          canSeeEvent(eventId) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.createdAt == request.time;

        allow delete: if status in ['going', 'maybe'] && (
          isOwner(uid) ||
          (isSignedIn() &&
           get(/databases/$(database)/documents/events/$(eventId)).data.creatorId == request.auth.uid)
        );
      }
    }

    match /usernames/{username} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /publicUpdates/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /serverMessages/{messageId} {
      allow read: if isSignedIn();

      allow create, update: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 80 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 400 &&
        request.resource.data.startAt is timestamp &&
        request.resource.data.endAt is timestamp &&
        request.resource.data.endAt > request.resource.data.startAt;

      allow delete: if isAdmin();
    }

    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to
      );

      allow create: if isSignedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to is string &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.status == "pending" &&
        (request.resource.data.createdAt == null ||
         request.resource.data.createdAt is timestamp);

      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.to &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status', 'acceptedAt']) &&
        request.resource.data.status == "accepted";

      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to
      );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
        request.auth.uid == resource.data.toUid;

      allow create: if false;

      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.toUid &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['read', 'visible']) &&
        (
          (request.resource.data.keys().hasAll(['read']) &&
           request.resource.data.read is bool) ||
          (request.resource.data.keys().hasAll(['visible']) &&
           request.resource.data.visible is bool)
        );

      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.toUid;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn() &&
        request.resource.data.creatorid == request.auth.uid &&
        (!('content' in request.resource.data) ||
          (request.resource.data.content is string &&
           request.resource.data.content.size() <= 5000)) &&
        (!('mentions' in request.resource.data) ||
          (request.resource.data.mentions is list &&
           request.resource.data.mentions.size() <= 20)) &&
        (!('imgs' in request.resource.data) ||
          (request.resource.data.imgs is list &&
           request.resource.data.imgs.size() <= 12)) &&
        (!('wallTo' in request.resource.data) ||
          request.resource.data.wallTo == request.auth.uid);

      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
         request.resource.data.likes is int &&
         (request.resource.data.likes - resource.data.get('likes', 0)) in [-1, 1]) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visible']) &&
         request.resource.data.visible is bool &&
         (resource.data.creatorid == request.auth.uid || isAdmin()))
      );

      allow delete: if isSignedIn() &&
        resource.data.creatorid == request.auth.uid;

      match /likers/{likerId} {
        allow read: if true;
        allow write: if isOwner(likerId);
      }

      match /coments/{comentId} {
        allow read: if true;

        allow create: if isSignedIn() &&
          request.resource.data.senderid == request.auth.uid;

        allow delete: if isSignedIn() && (
          resource.data.senderid == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.creatorid == request.auth.uid
        );

        allow update: if false;
      }
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participants
      );

      allow create: if isSignedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants[0] < request.resource.data.participants[1] &&
        chatId == 'chat-' + request.resource.data.participants[0] + '-' + request.resource.data.participants[1];

      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;

      allow delete: if isSignedIn() &&
        request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId) &&
          request.resource.data.sender == request.auth.uid;

        allow update: if isChatParticipant(chatId) &&
          request.resource.data.sender == resource.data.sender;

        allow delete: if isChatParticipant(chatId);
      }
    }

    match /activities/{activityId} {
      allow read: if true;

      allow create: if false;

      allow update: if isSignedIn() &&
        resource.data.actorUid == request.auth.uid &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['visible']) &&
        request.resource.data.visible is bool;

      allow delete: if isSignedIn() &&
        resource.data.actorUid == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if false;

      allow read: if isSignedIn();

      allow update: if (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'username', 'email', 'criadoem', 'nascimento', 'verified'])
        ) || (
          isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified']) &&
          request.resource.data.verified is bool
        );

      match /seenMessages/{messageId} {
        allow read, create: if isOwner(userId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /fcmTokens/{token} {
        allow read, write: if isOwner(userId);
      }

      match /user-infos/{infoId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      match /user-infos/user-media {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /convites/{inviteId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notifId} {
        allow read: if isOwner(userId);

        allow create: if false;

        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['read']) &&
          request.resource.data.read is bool;

        allow delete: if isOwner(userId);
      }

      match /saves/{postId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      match /following/{followingId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId);
        allow delete: if isSignedIn() && (
          request.auth.uid == userId ||
          request.auth.uid == followingId
        );
        allow update: if false;
      }

      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create: if isOwner(followerId);
        allow delete: if isSignedIn() && (
          request.auth.uid == userId ||
          request.auth.uid == followerId
        );
        allow update: if false;
      }

      match /friends/{friendId} {
        allow read: if isSignedIn();
        allow create, update, delete: if false;
      }

      match /wall/{postId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          (request.resource.data.createdAt == null ||
           request.resource.data.createdAt is timestamp) &&
          (
            (
              request.resource.data.postId is string &&
              request.resource.data.postId.size() > 0
            ) ||
            (
              request.resource.data.text is string &&
              request.resource.data.text.size() >= 1 &&
              request.resource.data.text.size() <= 180
            ) ||
            (
              request.resource.data.keys().hasOnly(['authorId', 'content', 'imgs', 'createdAt']) &&
              request.resource.data.content is string &&
              request.resource.data.content.size() <= 500 &&
              request.resource.data.imgs is list &&
              request.resource.data.imgs.size() <= 12 &&
              (request.resource.data.content.size() > 0 || request.resource.data.imgs.size() > 0)
            )
          ) &&
          (
            request.auth.uid == userId ||
            exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid))
          );

        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == userId
        );

        allow update: if false;

        match /likers/{likerId} {
          allow read: if true;
          allow write: if isOwner(likerId);
        }

        match /coments/{comentId} {
          allow read: if true;

          allow create: if isSignedIn() &&
            request.resource.data.senderid == request.auth.uid &&
            (
              (request.resource.data.text is string &&
               request.resource.data.text.size() >= 1) ||
              (request.resource.data.content is string &&
               request.resource.data.content.size() >= 1 &&
               request.resource.data.content.size() <= 2000)
            );

          allow delete: if isSignedIn() && (
            resource.data.senderid == request.auth.uid ||
            request.auth.uid == userId ||
            get(/databases/$(database)/documents/users/$(userId)/wall/$(postId)).data.authorId == request.auth.uid
          );

          allow update: if false;
        }
      }

      match /depoimentos/{depId} {
        allow read: if true;

        allow create: if isSignedIn() &&
          request.resource.data.creatorid == request.auth.uid;

        allow update: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == resource.data.creatorid) &&
          request.resource.data.creatorid == resource.data.creatorid;

        allow delete: if isSignedIn() &&
          (request.auth.uid == userId || request.auth.uid == resource.data.creatorid);
      }

      match /posts/{postId} {
        allow read: if true;

        allow create, update, delete: if isOwner(userId);

        match /coments/{comentId} {
          allow read: if true;

          allow create, update: if isSignedIn() &&
            request.auth.uid == request.resource.data.senderid;

          allow delete: if isSignedIn() && (
            request.auth.uid == resource.data.senderid ||
            request.auth.uid == userId
          );
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
