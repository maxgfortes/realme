rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /feelingNotes/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.feeling is string &&
        request.resource.data.text is string &&
        (request.resource.data.createdAt == null ||
         request.resource.data.createdAt is timestamp);
      allow delete: if request.auth != null &&
        request.auth.uid == userId;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null &&
        username.matches('^[a-z0-9_]+$') &&
        username.size() >= 3 &&
        username.size() <= 20;
      allow update, delete: if false;
    }

    match /publicUpdates/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /serverMessages/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (
        resource == null ||
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to
      );

      allow create: if request.auth != null &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to is string &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.status == "pending" &&
        (request.resource.data.createdAt == null ||
         request.resource.data.createdAt is timestamp);

      allow update: if request.auth != null &&
        request.auth.uid == resource.data.to &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status', 'acceptedAt']) &&
        request.resource.data.status == "accepted";

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.from ||
        request.auth.uid == resource.data.to
      );
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.toUid;

      allow create: if false;

      allow update: if request.auth != null &&
        request.auth.uid == resource.data.toUid &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['read', 'visible']) &&
        (
          (request.resource.data.keys().hasAll(['read']) &&
           request.resource.data.read is bool) ||
          (request.resource.data.keys().hasAll(['visible']) &&
           request.resource.data.visible is bool)
        );

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.toUid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;

      allow update: if request.auth != null && (
        (request.resource.data.keys().hasOnly(['likes']) &&
         request.resource.data.likes is int) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visible']) &&
         request.resource.data.visible is bool)
      );

      allow delete: if request.auth != null &&
        resource.data.creatorid == request.auth.uid;

      match /likers/{likerId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == likerId;
      }

      match /coments/{comentId} {
        allow read: if true;
        allow write: if request.auth != null &&
          request.auth.uid == request.resource.data.senderid;
      }
    }

    match /chats/{chatId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;

      allow update, delete: if request.auth != null &&
        request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants;
      }
    }

    match /activities/{activityId} {
      allow read: if true;

      allow create: if request.auth != null &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.type is string &&
        (request.resource.data.createdAt == null ||
         request.resource.data.createdAt is timestamp);

      allow update: if request.auth != null &&
        resource.data.actorUid == request.auth.uid &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['visible']) &&
        request.resource.data.visible is bool;

      allow delete: if request.auth != null &&
        resource.data.actorUid == request.auth.uid;
    }

    match /users/{userId} {

      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.username.matches('^[a-z0-9_]+$') &&
        request.resource.data.username.size() >= 3 &&
        request.resource.data.username.size() <= 20;

      allow read: if request.auth != null;

      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        (!('username' in request.resource.data) || (
          request.resource.data.username.matches('^[a-z0-9_]+$') &&
          request.resource.data.username.size() >= 3 &&
          request.resource.data.username.size() <= 20
        ));

      match /seenMessages/{messageId} {
        allow read, create: if request.auth != null &&
          request.auth.uid == userId;

        allow update: if false;
        allow delete: if request.auth != null &&
          request.auth.uid == userId;
      }

      match /user-infos/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
          request.auth.uid == userId;
      }

      match /user-infos/user-media {
        allow read: if true;
        allow write: if request.auth != null &&
          request.auth.uid == userId;
      }

      match /senha {
        allow read, write: if request.auth != null &&
          request.auth.uid == userId;
      }

      match /email {
        allow read, write: if request.auth != null &&
          request.auth.uid == userId;
      }

      match /convites/{doc} {
        allow read, write: if request.auth != null &&
          request.auth.uid == userId;
      }

      match /notifications/{notifId} {
        allow read: if request.auth != null &&
          request.auth.uid == userId;

        allow create: if request.auth != null &&
          request.resource.data.userId == userId;

        allow update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['read']) &&
          request.resource.data.read is bool;

        allow delete: if request.auth != null &&
          request.auth.uid == userId;
      }

      match /saves/{postId} {
        allow read: if request.auth != null &&
          request.auth.uid == userId;

        allow create: if request.auth != null &&
          request.auth.uid == userId;

        allow delete: if request.auth != null &&
          request.auth.uid == userId;

        allow update: if false;
      }

      match /following/{followingId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null &&
          request.auth.uid == userId;

        allow delete: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid == followingId
        );

        allow update: if false;
      }

      match /followers/{followerId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null &&
          request.auth.uid == followerId;

        allow delete: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.uid == followerId
        );

        allow update: if false;
      }

      match /friends/{friendId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;
      }

      match /wall/{postId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null &&
          request.resource.data.authorId == request.auth.uid &&
          (request.resource.data.createdAt == null ||
           request.resource.data.createdAt is timestamp) &&
          (
            (
              request.resource.data.postId is string &&
              request.resource.data.postId.size() > 0
            ) ||
            (
              request.resource.data.text is string &&
              request.resource.data.text.size() >= 1 &&
              request.resource.data.text.size() <= 180
            )
          ) &&
          (
            request.auth.uid == userId ||
            exists(
              /databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)
            )
          );

        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == userId
        );

        allow update: if false;

        match /likers/{likerId} {
          allow read: if true;
          allow write: if request.auth != null &&
            request.auth.uid == likerId;
        }

        match /coments/{comentId} {
          allow read: if true;

          allow create: if request.auth != null &&
            request.resource.data.senderid == request.auth.uid &&
            request.resource.data.text is string &&
            request.resource.data.text.size() >= 1;

          allow delete: if request.auth != null &&
            resource.data.senderid == request.auth.uid;

          allow update: if false;
        }
      }

      match /depoimentos/{depId} {
        allow read: if true;

        allow write: if request.auth != null &&
          (
            request.auth.uid == userId ||
            request.auth.uid == resource.data.creatorid ||
            request.auth.uid == request.resource.data.creatorid
          );
      }

      match /posts/{postId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null &&
          request.auth.uid == userId;

        match /coments/{comentId} {
          allow read: if true;

          allow write: if request.auth != null &&
            request.auth.uid == request.resource.data.senderid;
        }
      }
    }
  }
}